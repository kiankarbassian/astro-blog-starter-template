{
	"compatibility_date": "2026-04-08",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "creative-portfolio",
	"main": "server/worker.ts",
	"workers_dev": true,
	"ai": {"binding":"AI"},
	"routes": [{"pattern":"kiankarbassian.com","zone_name":"kiankarbassian.com","custom_domain":true}],
	"assets": {
		"directory": "./dist",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	}
}
