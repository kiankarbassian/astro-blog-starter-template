---
const education = {
  school: "University of Illinois Urbana-Champaign",
  degree: "Bachelor of Science in Computer Engineering",
  expected: "Expected May 2028"
};

const skills = [
  { name: "Python", level: 95 },
  { name: "C++", level: 90 },
  { name: "Go", level: 85 },
  { name: "TypeScript", level: 80 }
];

const awards = [
  "Harvard Book Prize",
  "Duke of Edinburgh Silver Award",
  "Climate Science Olympiad Semi-finalist"
];
---

<section id="about" class="about section-light">
  <div class="section-bg-gradient"></div>
  <div class="container">
    <div class="about-grid">
      <div class="about-header">
        <p class="eyebrow">About Me</p>
        <h2 class="headline-medium">Engineering the future.</h2>
        <p class="about-intro">
          I'm a Computer Engineering student at UIUC with a passion for building scalable software systems and exploring emerging technologies. My experience spans full-stack development, embedded systems, and machine learning integration.
        </p>
      </div>
      <div class="about-visual">
        <div class="about-icon">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="4" y="4" width="56" height="56" rx="12" fill="#1d1d1f" fill-opacity="0.05"/>
            <path d="M32 18C24.268 18 18 24.268 18 32C18 39.732 24.268 46 32 46C39.732 46 46 39.732 46 32C46 24.268 39.732 18 32 18ZM32 20C38.627 20 44 25.373 44 32C44 38.627 38.627 44 32 44C25.373 44 20 38.627 20 32C20 25.373 25.373 20 32 20Z" fill="#1d1d1f" fill-opacity="0.3"/>
            <path d="M32 22C26.477 22 22 26.477 22 32C22 37.523 26.477 42 32 42C37.523 42 42 37.523 42 32C42 26.477 37.523 22 32 22ZM30 28L34 32L30 36V28Z" fill="#0071e3"/>
          </svg>
        </div>
      </div>
    </div>

    <div class="education-card">
      <div class="education-content">
        <h3 class="education-school">{education.school}</h3>
        <p class="education-degree">{education.degree}</p>
        <p class="education-date">{education.expected}</p>
      </div>
      <a href="#contact" class="link-learn-more">Learn more</a>
    </div>

    <div class="skills-section">
      <h3 class="skills-title">Technical Skills</h3>
      <div class="skills-grid">
        {skills.map((skill) => (
          <div class="skill-card">
            <div class="skill-header">
              <span class="skill-name">{skill.name}</span>
              <span class="skill-level">{skill.level}%</span>
            </div>
            <div class="skill-bar">
              <div class="skill-fill" style={`width: ${skill.level}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="awards-section">
      <h3 class="awards-title">Recognition</h3>
      <div class="awards-grid">
        {awards.map((award) => (
          <div class="award-card">
            <span class="award-text">{award}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 100px 0;
    position: relative;
  }

  .section-bg-gradient {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 200px;
    background: linear-gradient(to bottom, rgba(0, 113, 227, 0.03), transparent);
    pointer-events: none;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: start;
    margin-bottom: 60px;
  }

  .about-header {
    max-width: 600px;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.12px;
    text-transform: uppercase;
    color: var(--apple-blue);
    margin-bottom: 8px;
  }

  .headline-medium {
    color: var(--near-black);
    margin-bottom: 16px;
  }

  .about-intro {
    font-size: 17px;
    line-height: 1.47;
    letter-spacing: -0.374px;
    color: var(--text-secondary);
    max-width: 520px;
  }

  .about-visual {
    flex-shrink: 0;
  }

  .about-icon {
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--white);
    border-radius: 24px;
    box-shadow: var(--shadow-card);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about-icon:hover {
    transform: scale(1.05) rotate(2deg);
    box-shadow: rgba(0, 0, 0, 0.22) 5px 8px 40px 0px;
  }

  .education-card {
    background: var(--white);
    border-radius: 12px;
    padding: 24px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 60px;
    box-shadow: var(--shadow-card);
  }

  .education-content {
    flex: 1;
  }

  .education-school {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.19;
    letter-spacing: 0.231px;
    color: var(--near-black);
    margin-bottom: 4px;
  }

  .education-degree {
    font-size: 15px;
    color: var(--text-secondary);
    margin-bottom: 4px;
  }

  .education-date {
    font-size: 14px;
    color: var(--text-tertiary);
  }

  .skills-section {
    margin-bottom: 60px;
  }

  .skills-title, .awards-title {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.224px;
    color: var(--near-black);
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 40px;
    max-width: 600px;
  }

  .skill-card {
    background: var(--white);
    border-radius: 8px;
    padding: 16px 20px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .skill-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  .skill-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .skill-name {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.224px;
    color: var(--near-black);
  }

  .skill-level {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-tertiary);
  }

  .skill-bar {
    height: 4px;
    background: rgba(0, 0, 0, 0.08);
    border-radius: 2px;
    overflow: hidden;
  }

  .skill-fill {
    height: 100%;
    background: var(--apple-blue);
    border-radius: 2px;
  }

  .awards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .award-card {
    background: var(--white);
    border-radius: 8px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .award-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  .award-text {
    font-size: 14px;
    font-weight: 400;
    letter-spacing: -0.224px;
    color: var(--near-black);
  }

  @media (max-width: 834px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .about-visual {
      order: -1;
    }

    .about-icon {
      margin: 0 auto;
    }

    .education-card {
      flex-direction: column;
      text-align: center;
      gap: 20px;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }

    .awards-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .about {
      padding: 60px 0;
    }

    .about-icon {
      width: 80px;
      height: 80px;
    }

    .about-icon svg {
      width: 40px;
      height: 40px;
    }
  }
</style>
