---
const projects = [
  { 
    name: "Ultrasonic Measuring Tool", 
    description: "Precision distance measurement using ultrasonic sensors with real-time data visualization",
    tag: "Embedded Systems"
  },
  { 
    name: "Environmental Weather Monitor", 
    description: "IoT-based temperature, humidity, and weather tracking with predictive analytics",
    tag: "IoT"
  },
  { 
    name: "Autonomous Vehicle Prototype", 
    description: "Self-driving vehicle with obstacle avoidance and path planning algorithms",
    tag: "Robotics"
  }
];
---

<section id="projects" class="projects section-dark">
  <div class="float-layer project-float"></div>
  <div class="container">
    <div class="projects-header">
      <p class="eyebrow">Projects</p>
      <h2 class="headline-large">Built with purpose.</h2>
      <p class="projects-subtitle">
        From embedded systems to machine learning, each project pushes the boundaries of what's possible.
      </p>
    </div>
    
    <div class="projects-grid">
      {projects.map((project) => (
        <div class="project-card">
          <div class="project-visual">
            <div class="project-icon">
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="2" stroke-opacity="0.3"/>
                <circle cx="24" cy="24" r="12" stroke="currentColor" stroke-width="2" stroke-opacity="0.5"/>
                <circle cx="24" cy="24" r="4" fill="currentColor"/>
              </svg>
            </div>
          </div>
          <div class="project-content">
            <p class="project-tag">{project.tag}</p>
            <h3 class="project-name">{project.name}</h3>
            <p class="project-description">{project.description}</p>
            <div class="project-links">
              <a href="#" class="link-learn-more link-learn-more-dark">Learn more</a>
              <a href="#" class="link-shop">View code</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    padding: 100px 0;
  }

  .projects-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.12px;
    text-transform: uppercase;
    color: var(--bright-blue);
    margin-bottom: 8px;
  }

  .headline-large {
    color: var(--white);
    margin-bottom: 12px;
  }

  .projects-subtitle {
    font-size: 17px;
    line-height: 1.47;
    letter-spacing: -0.374px;
    color: var(--text-on-dark);
    max-width: 520px;
    margin: 0 auto;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .project-card {
    background: var(--dark-surface-1);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 380px;
  }

  .project-visual {
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--dark-surface-2) 0%, var(--dark-surface-4) 100%);
  }

  .project-icon {
    color: var(--white);
    opacity: 0.6;
  }

  .project-content {
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .project-tag {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.12px;
    text-transform: uppercase;
    color: var(--bright-blue);
    margin-bottom: 8px;
  }

  .project-name {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.19;
    letter-spacing: 0.231px;
    color: var(--white);
    margin-bottom: 8px;
  }

  .project-description {
    font-size: 14px;
    line-height: 1.43;
    letter-spacing: -0.224px;
    color: var(--text-on-dark);
    margin-bottom: 16px;
    flex: 1;
  }

  .project-links {
    display: flex;
    gap: 20px;
  }

  .float-layer.project-float {
    position: absolute;
    top: 20%;
    right: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 113, 227, 0.08) 0%, transparent 60%);
    border-radius: 50%;
    pointer-events: none;
    animation: projectFloat 15s ease-in-out infinite;
  }

  @keyframes projectFloat {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(-40px, 30px) rotate(10deg); }
  }

  .project-card {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), 
                box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transform-style: preserve-3d;
    perspective: 1000px;
  }

  .project-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(0, 113, 227, 0.15);
  }

  .project-card:hover .project-visual {
    background: linear-gradient(135deg, var(--dark-surface-3) 0%, var(--dark-surface-4) 100%);
  }

  .project-card:hover .project-icon {
    transform: scale(1.1);
    opacity: 0.8;
  }

  .project-icon {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s;
  }

  @media (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .projects {
      padding: 60px 0;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      min-height: auto;
    }
  }

  @media (max-width: 480px) {
    .project-visual {
      height: 140px;
    }
  }
</style>
