<script>
  const root = document.querySelector<HTMLElement>('.cpu-workbench');
  if (root) {
    const start = 0x3000;
    type Program = {name:string; description:string; words:number[]; data:Record<number,number>};
    const programs:Program[] = [
      {name:'ARITHMETIC',description:'ADD, NOT and AND write back to 16-bit registers.',words:[0x1025,0x1223,0x943F,0x5641,0x193F],data:{}},
      {name:'MEMORY',description:'PC-relative addressing loads a number, increments it, stores it back, then reads it again.',words:[0xE006,0x2205,0x1261,0x3203,0x2402],data:{12295:7}},
      {name:'BRANCH LOOP',description:'A countdown uses condition codes to choose whether to repeat an instruction.',words:[0x1023,0x103F,0x03FE,0x923F],data:{}}
    ];
    const mask = (v:number) => v & 0xffff;
    const hex = (v:number) => 'x' + mask(v).toString(16).toUpperCase().padStart(4,'0');
    const sext = (v:number,bits:number) => (v & (1 << (bits-1))) ? v-(1<<bits) : v;
    const signed = (v:number) => (v & 0x8000) ? v - 0x10000 : v;
    const bits = (v:number) => mask(v).toString(2).padStart(16,'0');
    const el = (selector:string) => root.querySelector<HTMLElement>(selector);
    const setText = (key:string,value:string) => {
      root.querySelectorAll<HTMLElement>('[data-bind="' + key + '"]').forEach(node => node.textContent = value);
    };
    let timer:ReturnType<typeof setInterval>|undefined;
    let programIndex = 0;
    let mem = new Map<number,number>();
    let regs:number[] = Array(8).fill(0);
    let pc = start, mar = 0, mdr = 0, ir = 0, bus = 0, instrAddr = start, cycles = 0, instructions = 0;
    let cc = 'Z', phase = 'addr', halted = false, lastReg = -1, alu = 'ADD / AND';
    let description = '', phaseTag = 'READY', signals:string[] = [];
    let units:string[] = [];
    const done = () => {
      phase = 'addr';
      instructions++;
      if (pc < start || pc >= start + programs[programIndex].words.length) {
        halted = true;
        phaseTag = 'COMPLETE';
        description += ' Program complete. Reset or load another example to continue.';
      }
    };
    const setCC = (value:number) => { const n = signed(mask(value)); cc = n < 0 ? 'N' : n > 0 ? 'P' : 'Z'; };
    const disassemble = (word:number) => {
      const op = word >>> 12, dr = (word>>>9)&7, sr=(word>>>6)&7, reg=word&7;
      const operand = (word & 0x20) ? '#' + sext(word&31,5) : 'R'+reg;
      if (op===1) return 'ADD R'+dr+', R'+sr+', '+operand;
      if (op===5) return 'AND R'+dr+', R'+sr+', '+operand;
      if (op===9) return 'NOT R'+dr+', R'+sr;
      if (op===2) return 'LD R'+dr+', #'+sext(word&511,9);
      if (op===3) return 'ST R'+dr+', #'+sext(word&511,9);
      if (op===14) return 'LEA R'+dr+', #'+sext(word&511,9);
      if (op===0) return 'BR'+((word&0x800)?'n':'')+((word&0x400)?'z':'')+((word&0x200)?'p':'')+' #'+sext(word&511,9);
      return '.FILL '+hex(word);
    };
    const explanation = (word:number) => {
      const op=word>>>12;
      if(op===1) return 'ADD combines a source register with a register or signed immediate, writes the 16-bit result, and updates NZP.';
      if(op===5) return 'AND performs a bitwise operation, writes a register, and updates NZP.';
      if(op===9) return 'NOT inverts all 16 bits of the source register, then updates NZP.';
      if(op===2) return 'LD reads a word from PC + signed offset9, loads a destination register, and updates NZP.';
      if(op===3) return 'ST writes a source register to memory at PC + signed offset9.';
      if(op===14) return 'LEA writes the computed PC-relative address into a register and updates NZP.';
      if(op===0) return 'BR compares the instruction NZP mask to the current condition code and may change the PC.';
      return 'This instruction is not included in the interactive subset.';
    };
    const reset = (index:number) => {
      pause();
      programIndex=index;mem=new Map<number,number>();regs=Array(8).fill(0);
      programs[index].words.forEach((w,i)=>mem.set(start+i,w));
      Object.entries(programs[index].data).forEach(([addr,value])=>mem.set(Number(addr),value));
      pc=start;mar=0;mdr=0;ir=0;bus=0;instrAddr=start;cc='Z';
      cycles=0;instructions=0;phase='addr';halted=false;lastReg=-1;alu='ADD / AND';
      description=programs[index].description + ' Press Step to advance one micro-operation.';
      phaseTag='READY';signals=[];units=[];
      render();
    };
    const tick = () => {
      if(halted) return;
      cycles++;lastReg=-1;signals=[];units=[];
      const op=ir>>>12, dr=(ir>>>9)&7, sr=(ir>>>6)&7, second=ir&7;
      if(phase==='addr'){
        instrAddr=pc;bus=pc;mar=pc;pc=mask(pc+1);
        phase='read';phaseTag='FETCH / ADDRESS';units=['PC','MAR'];signals=['GATE_PC','LD_MAR','LD_PC'];
        description='Place the current PC on the address path, latch it into MAR, and increment the PC.';
      } else if(phase==='read'){
        mdr=mem.get(mar)??0;bus=mdr;
        phase='latch';phaseTag='FETCH / MEMORY';units=['MEM','MDR'];signals=['MEM_EN','LD_MDR'];
        description='Read the 16-bit instruction at MAR into the Memory Data Register.';
      } else if(phase==='latch'){
        ir=mdr;bus=mdr;phase='execute';phaseTag='DECODE';units=['MDR'];signals=['GATE_MDR','LD_IR'];
        description='Copy MDR into IR. The opcode and operand fields now determine the next operation.';
      } else if(phase==='execute'){
        const offset=sext(ir&511,9);
        if(op===1 || op===5){
          const rhs=(ir&0x20)?sext(ir&31,5):regs[second];
          const result=mask(op===1?regs[sr]+rhs:regs[sr]&rhs);
          regs[dr]=result;bus=result;lastReg=dr;setCC(result);alu=op===1?'ADD':'AND';
          units=['REG','ALU'];signals=['GATE_ALU','LD_REG','LD_CC'];
          phaseTag='EXECUTE / ALU';description=disassemble(ir)+' produced '+hex(result)+' (signed '+signed(result)+'). Destination and condition codes updated.';done();
        }else if(op===9){
          const result=mask(~regs[sr]);regs[dr]=result;bus=result;lastReg=dr;setCC(result);alu='NOT';
          units=['REG','ALU'];signals=['GATE_ALU','LD_REG','LD_CC'];
          phaseTag='EXECUTE / NOT';description='Invert '+hex(regs[sr])+' to get '+hex(result)+'. The result is written to R'+dr+'.';done();
        }else if(op===14){
          const addr=mask(pc+offset);regs[dr]=addr;bus=addr;lastReg=dr;setCC(addr);
          units=['PC','REG'];signals=['ADDR_ADDER','LD_REG','LD_CC'];
          phaseTag='EXECUTE / ADDRESS';description='Compute PC '+(offset>=0?'+ ':'- ')+Math.abs(offset)+' = '+hex(addr)+' and write the address into R'+dr+'.';done();
        }else if(op===0){
          const maskNZP=(ir>>>9)&7;
          const matches=(cc==='N'&&Boolean(maskNZP&4))||(cc==='Z'&&Boolean(maskNZP&2))||(cc==='P'&&Boolean(maskNZP&1));
          if(matches) pc=mask(pc+offset);
          bus=pc;units=['PC'];signals=['LD_BEN','PCMUX'];
          phaseTag='EXECUTE / BRANCH';description='Condition '+cc+' '+(matches?'matches':'does not match')+' the branch mask. '+(matches?'PC becomes '+hex(pc)+'.':'Execution continues sequentially.');done();
        }else if(op===2 || op===3){
          mar=mask(pc+offset);bus=mar;units=['PC','MAR'];signals=['ADDR_ADDER','LD_MAR'];
          phaseTag='ADDRESS CALC';description='Compute the PC-relative effective address '+hex(mar)+' and latch it into MAR.';
          phase=op===2?'load-read':'store-prep';
        }else{
          halted=true;phaseTag='UNSUPPORTED';description='Unsupported opcode '+op.toString(16).toUpperCase()+'. Load a sample program to continue.';
        }
      } else if(phase==='load-read'){
        mdr=mem.get(mar)??0;bus=mdr;units=['MEM','MDR'];signals=['MEM_EN','LD_MDR'];
        phase='load-write';phaseTag='MEMORY / READ';description='Read memory['+hex(mar)+'] = '+hex(mdr)+' into MDR.';
      } else if(phase==='load-write'){
        const dest=(ir>>>9)&7;regs[dest]=mdr;bus=mdr;lastReg=dest;setCC(mdr);
        units=['MDR','REG'];signals=['GATE_MDR','LD_REG','LD_CC'];
        phaseTag='WRITEBACK';description='Write '+hex(mdr)+' into R'+dest+' and update the condition codes.';done();
      } else if(phase==='store-prep'){
        const source=(ir>>>9)&7;mdr=regs[source];bus=mdr;units=['REG','MDR'];signals=['LD_MDR'];
        phaseTag='STORE / PREPARE';description='Copy the value in R'+source+' ('+hex(mdr)+') into MDR.';
        phase='store-write';
      } else if(phase==='store-write'){
        mem.set(mar,mdr);bus=mdr;units=['MDR','MEM'];signals=['MEM_WR'];
        phaseTag='MEMORY / WRITE';description='Store '+hex(mdr)+' into memory['+hex(mar)+'].';done();
      }
    };
    const render = () => {
      const program=programs[programIndex];
      setText('clock',String(cycles).padStart(3,'0'));
      setText('pc',hex(pc));setText('mar',hex(mar));setText('mdr',hex(mdr));setText('ir',hex(ir));setText('bus',hex(bus));
      setText('unit-pc',hex(pc));setText('unit-mar',hex(mar));setText('unit-mdr',hex(mdr));setText('alu',alu);
      setText('phase-tag',phaseTag);setText('description',description);
      setText('program-name',program.name);
      setText('status',halted?'PROGRAM COMPLETE':'INSTRUCTION '+String(instructions+1).padStart(2,'0')+' / CYCLE '+String(cycles).padStart(3,'0'));
      const activeAddr=(phase==='addr')?pc:instrAddr;
      const instruction=mem.get(activeAddr)??ir;
      setText('instruction',halted?'End of program':disassemble(instruction));
      setText('decode',explanation(instruction));
      setText('opcode','OPCODE '+bits(instruction).slice(0,4));
      const binary=bits(instruction);
      setText('binary',binary.slice(0,4)+' '+binary.slice(4,7)+' '+binary.slice(7,10)+' '+binary.slice(10));
      root.querySelectorAll<HTMLElement>('[data-program]').forEach(node=>node.setAttribute('aria-pressed',String(Number(node.dataset.program)===programIndex)));
      root.querySelectorAll<HTMLElement>('[data-unit]').forEach(node=>node.classList.toggle('active',units.includes(node.dataset.unit||'')));
      root.querySelectorAll<HTMLElement>('[data-reg]').forEach(node=>{
        const n=Number(node.dataset.reg);const val=node.querySelector('strong');
        if(val) val.textContent=hex(regs[n]);node.classList.toggle('changed',n===lastReg);
      });
      root.querySelectorAll<HTMLElement>('[data-flag]').forEach(node=>node.classList.toggle('active',node.dataset.flag===cc));
      const bars=root.querySelectorAll<HTMLElement>('.cpu-bus-bars i');
      bars.forEach((node,index)=>node.classList.toggle('on',Boolean(bus & (1 << (15-index)))));
      const signalBox=el('[data-signals]');
      if(signalBox){signalBox.replaceChildren();(signals.length?signals:['IDLE']).forEach(signal=>{
        const span=document.createElement('span');span.textContent=signal;signalBox.append(span);
      });}
      const codeBox=el('[data-code]');
      if(codeBox){
        codeBox.replaceChildren();
        program.words.forEach((word,index)=>{
          const address=start+index;const row=document.createElement('div');
          row.className='cpu-code-row'+(address===activeAddr&&!halted?' active':'')+(address<activeAddr?' past':'');
          const addr=document.createElement('span'),value=document.createElement('span'),instr=document.createElement('strong');
          addr.textContent=hex(address);value.textContent=hex(mem.get(address)??word);instr.textContent=disassemble(mem.get(address)??word);
          row.append(addr,value,instr);codeBox.append(row);
        });
      }
      const runBtn=el('[data-action=run]') as HTMLButtonElement|null;
      const stepBtn=el('[data-action=step]') as HTMLButtonElement|null;
      if(runBtn){runBtn.disabled=halted;runBtn.querySelector('span')!.textContent=timer?'Pause':'Run';runBtn.firstChild!.textContent=timer?'Ⅱ ':'▶ ';}
      if(stepBtn)stepBtn.disabled=halted;
    };
    const pause=()=>{if(timer!==undefined){clearInterval(timer);timer=undefined;}};
    const advance=()=>{tick();if(halted)pause();render();};
    root.querySelectorAll<HTMLButtonElement>('[data-program]').forEach(button=>button.addEventListener('click',()=>reset(Number(button.dataset.program))));
    root.querySelector('[data-action=step]')?.addEventListener('click',()=>{pause();advance();});
    root.querySelector('[data-action=reset]')?.addEventListener('click',()=>reset(programIndex));
    root.querySelector('[data-action=run]')?.addEventListener('click',()=>{
      if(timer!==undefined){pause();render();return;}
      if(halted)return;
      timer=setInterval(advance,780);advance();
    });
    document.addEventListener('visibilitychange',()=>{if(document.hidden){pause();render();}});
    reset(0);
  }
</script>
