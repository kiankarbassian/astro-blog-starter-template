<section id="contact" class="contact section-light">
  <div class="container">
    <div class="contact-content">
      <p class="eyebrow">Contact</p>
      <h2 class="headline-large">Let us connect.</h2>
      <p class="contact-subtitle">
        I am always open to discussing new opportunities, collaborations, or just chatting about technology and engineering.
      </p>
      <div class="contact-actions">
        <a href="mailto:kiank2@illinois.edu" class="btn btn-primary magnetic">Send Email</a>
        <a href="https://linkedin.com/in/kiankarbassian" target="_blank" rel="noopener" class="btn btn-pill btn-pill-light magnetic">View LinkedIn</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 100px 0;
  }

  .contact-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.12px;
    text-transform: uppercase;
    color: var(--apple-blue);
    margin-bottom: 8px;
  }

  .headline-large {
    color: var(--near-black);
    margin-bottom: 12px;
  }

  .contact-subtitle {
    font-size: 17px;
    line-height: 1.47;
    letter-spacing: -0.374px;
    color: var(--text-secondary);
    margin-bottom: 32px;
  }

  .contact-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    margin-bottom: 40px;
  }

  .contact-actions .btn {
    position: relative;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), 
                box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-actions .btn::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.5s, height 0.5s;
  }

  .contact-actions .btn:hover::before {
    width: 250px;
    height: 250px;
  }

  .contact-actions .btn:hover {
    transform: translateY(-2px);
  }

  .contact-actions .btn-primary:hover {
    box-shadow: 0 8px 30px rgba(0, 113, 227, 0.4);
  }

  .contact-actions .btn-pill:hover {
    box-shadow: 0 4px 20px rgba(0, 102, 204, 0.3);
  }

  @media (max-width: 768px) {
    .contact {
      padding: 60px 0;
    }

    .contact-actions {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
