---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <p class="footer-name">Kian Karbassian</p>
        <p class="footer-tagline">Computer Engineering at UIUC</p>
      </div>
      <nav class="footer-nav">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p class="footer-copyright">Copyright © {currentYear} Kian Karbassian. All rights reserved.</p>
      <p class="footer-built">Built with Astro</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--black);
    padding: 40px 0 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-brand {
    flex: 1;
    min-width: 200px;
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 4px;
  }

  .footer-tagline {
    font-size: 14px;
    color: var(--text-on-dark);
  }

  .footer-nav {
    display: flex;
    gap: 24px;
  }

  .footer-nav a {
    font-size: 14px;
    color: var(--text-on-dark);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: var(--white);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer-copyright,
  .footer-built {
    font-size: 12px;
    color: var(--text-on-dark-tertiary);
  }

  @media (max-width: 640px) {
    .footer-content {
      flex-direction: column;
      text-align: center;
    }

    .footer-nav {
      justify-content: center;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>
