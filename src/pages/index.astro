---
import Layout from '../layouts/Layout.astro';
import Signal from '../components/Signal.astro';

const experience = [
  { company: 'CCC Intelligent Solutions', role: 'AI Engineering Intern', time: 'May 2026 - present', place: 'Chicago, IL', type: 'AI systems', accent: 'orange', summary: 'Developed a vehicle damage assessment pipeline combining multimodal AI, agent-controlled image cropping, and reference imagery aggregated from multiple APIs. Implemented specialized agents for vehicle-area analysis and a multistage debate workflow to compare and refine damage assessments. Built a reproducible evaluation framework across 126 standardized images, integrating ground-truth comparisons and agent-assisted error analysis. Measured precision and recall to diagnose false positives, missed damage, and opportunities to improve assessment quality.', impact: '126 standardized images · Precision & recall' },
  { company: 'Lossdog', role: 'Software Engineering Intern', time: 'Jan 2026 - May 2026', place: 'Chicago, IL', type: 'Infrastructure', accent: 'lime', summary: 'Independently built an internal administration app using React Admin, Go, and PostgreSQL. Integrated an AI agent capable of creating, reading, updating, and deleting database records, reducing manual administrative work. Implemented a cryptocurrency quote ingestion pipeline that consolidated feeds from multiple sources and buffered incoming updates to handle bursts and irregular arrival patterns, processing 1,000+ quotes per second with under 50ms latency. Developed a prediction-market analysis tool combining Kalshi and Polymarket listings with AI assessments and trading metrics. Flagged potential insider-influence and manipulation risks while surfacing potential trading opportunities for users to evaluate.', impact: '1,000+ quotes / sec · <50ms latency' },
  { company: 'Crédit Agricole (CACIB)', role: 'RPA Intern', time: 'Jul 2021 - Sept 2021', place: 'Hong Kong', type: 'Automation', accent: 'blue', summary: 'Automated OCR extraction and web scraping for documents and market data feeds.', impact: '100+ documents processed' },
];

const projects = [
  { number: '01', title: 'Agent Evaluation Framework', label: 'Agent evaluation', description: 'An evaluation framework that measures grounding, latency, and reasoning quality in AI agents.', tags: ['LLMs', 'observability', 'evaluation'], accent: 'orange', glyph: 'pulse' },
  { number: '02', title: 'EEG-Based Adaptive Audio', label: 'NeurotechX UIUC', description: 'Supervised models classify cognitive states from EEG streams and translate them into adaptive audio via the Spotify API.', tags: ['BCI', 'Python', 'Spotipy'], accent: 'blue', glyph: 'wave' },
  { number: '03', title: 'Arduino Projects', label: 'Arduino projects', description: 'Six embedded systems experiments in C/C++ - from ultrasonic sensing to autonomous navigation prototypes.', tags: ['C/C++', 'sensors', 'autonomy'], accent: 'lime', glyph: 'orbit' },
  { number: '04', title: 'Formula SAE Circuit Design', label: 'Illini Electric Motorsports', description: 'Designed five high- and low-voltage circuits for Formula SAE Electric, with SPICE simulation and cross-team integration.', tags: ['Altium', 'SPICE', 'EV systems'], accent: 'violet', glyph: 'grid' },
];

const skills = ['Python', 'C++', 'Go', 'TypeScript', 'Assembly', 'LangGraph', 'PostgreSQL', 'React', 'Arduino', 'Altium Designer', 'MCP', 'NATS'];
---

<Layout title="Kian Karbassian - AI + systems engineer">
  <main id="main-content">
    <section class="hero" id="top">
      <div class="container hero-inner">
        <div class="hero-kicker reveal">Computer engineering at UIUC</div>
        <div class="hero-layout">
          <div class="hero-copy">
            <p class="hero-index reveal">AI &amp; Software Engineering</p>
            <h1 class="hero-title reveal">Kian<br /><span>Karbassian</span></h1>
            <p class="hero-description reveal">I’m a computer engineering student at the University of Illinois Urbana-Champaign, with experience in AI, software engineering, and embedded systems.</p>
            <div class="hero-actions reveal"><a class="button button-primary" href="#work">View projects <span>↘</span></a><a class="text-link" href="/resume.pdf" target="_blank" rel="noopener">Open résumé <span>↗</span></a></div>
          </div>
          <Signal />
        </div>

      </div>
    </section>

    <section class="intro section-light" id="about"><div class="container intro-grid"><div class="section-marker reveal"><span>About</span></div><div class="intro-copy"><h2 class="display reveal">About me</h2><p class="body-copy reveal">My interests include multimodal AI, agent evaluation, neurotechnology, and embedded hardware. I’ve worked on computer vision systems, backend infrastructure, and circuit design. I expect to graduate in 2028.</p><div class="fact-row reveal"><div><strong>2028</strong><span>Expected graduation</span></div><div><strong>UIUC</strong><span>Computer engineering</span></div><div><strong>AI + ECE</strong><span>Areas of interest</span></div></div></div></div></section>

    <section class="experience section-dark" id="experience"><div class="container"><div class="section-head reveal"><div class="section-marker section-marker-dark"><span>Experience</span></div><h2 class="display display-light">Experience</h2></div><div class="experience-list">{experience.map((item, index) => (<article class={`experience-item accent-${item.accent} reveal`}><div class="experience-number">{item.type}</div><div class="experience-main"><div class="experience-meta"><span>{item.time}</span></div><h3>{item.company}</h3><p class="experience-role">{item.role} <span>·</span> {item.place}</p><p class="experience-summary">{item.summary}</p></div><div class="experience-impact"><span>impact</span><strong>{item.impact}</strong></div></article>))}</div></div></section>

    <section class="work section-cream" id="work"><div class="container"><div class="work-heading reveal"><div class="section-marker"><span>Selected work</span></div><div><h2 class="display">Projects</h2></div><p class="body-copy">Selected projects in AI, embedded systems, and electrical engineering.</p></div><div class="project-grid">{projects.map((project) => (<article class={`project-card project-${project.accent} reveal`}><div class="project-card-top"><span class="project-label">{project.label}</span></div><div class={`project-glyph glyph-${project.glyph}`} aria-hidden="true">{project.glyph === 'pulse' && <><span></span><span></span><span></span><span></span><span></span><span></span></>}{project.glyph === 'wave' && <div class="wave-line"></div>}{project.glyph === 'orbit' && <><i></i><i></i><i></i></>}{project.glyph === 'grid' && <><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></>}</div><h3>{project.title}</h3><p>{project.description}</p><div class="project-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div></article>))}</div></div></section>

    <section class="toolkit section-dark" id="toolkit"><div class="container toolkit-grid"><div><div class="section-marker section-marker-dark reveal"><span>Toolkit</span></div><h2 class="display display-light reveal">Technical skills</h2><p class="body-copy body-copy-light reveal">Languages, frameworks, and tools I’ve used across my work and projects.</p></div><div class="skills-cloud reveal">{skills.map((skill, index) => <span class={`skill-chip chip-${index % 4}`}>{skill}</span>)}</div></div></section>

    <section class="contact section-orange" id="contact"><div class="container contact-inner"><div class="section-marker reveal"><span>Contact</span></div><div class="contact-copy"><h2 class="display reveal">Contact</h2><div class="contact-links reveal"><a class="contact-email" href="mailto:kkarbassian@gmail.com">kkarbassian@gmail.com <span>↗</span></a><a class="text-link text-link-dark" href="https://linkedin.com/in/kiankarbassian" target="_blank" rel="noopener">LinkedIn <span>↗</span></a></div></div></div></section>
  </main>
</Layout>
