---
import Layout from '../layouts/Layout.astro';
import Signal from '../components/Signal.astro';
import DamageScan from '../components/DamageScan.astro';
import MarketScan from '../components/MarketScan.astro';

const experience = [
  {
    company: 'CCC Intelligent Solutions', url: 'https://www.cccis.com/', role: 'AI Engineering Intern', time: 'May 2026 - present', place: 'Chicago, IL', type: 'AI development', accent: 'orange',
    summary: [
      'Built an AI tool to assess vehicle damage using photos, image cropping, and reference images. Diagnostic accuracy improved by 18% on internal benchmarks.',
      'Added AI agents that inspect different parts of a vehicle and compare their findings to refine the damage assessment.',
      'Tested assessments on 126 standardized images to check for false positives and missed damage. Built tests for agent performance that reduced model output drift by 35%.',
    ],
    impact: '18% higher diagnostic accuracy · 35% less output drift · 126 test images',
  },
  {
    company: 'Lossdog', url: 'https://lossdog.com/', role: 'Software Engineering Intern', time: 'Jan 2026 - May 2026', place: 'Chicago, IL', type: 'Software development', accent: 'lime',
    summary: [
      'Built an internal admin app with React Admin, Go, and PostgreSQL for 12 users. Added an AI agent to manage database records and reduce manual data entry.',
      'Built a cryptocurrency quote system using NATS to combine feeds and handle bursts of updates, processing 1,000+ quotes per second with under 50ms latency.',
      'Built a tool to compare Kalshi and Polymarket listings, using AI and trading data to flag possible insider influence, suspicious activity, and trading opportunities.',
    ],
    impact: '12 internal users · 1,000+ quotes / sec · <50ms latency',
  },
  {
    company: 'Crédit Agricole (CACIB)', url: 'https://www.ca-cib.com/home', role: 'RPA Intern', time: 'Jul 2021 - Sept 2021', place: 'Hong Kong', type: 'Automation', accent: 'blue',
    summary: ['Built Python and MySQL tools to extract text from 100+ documents and scrape market data feeds.'],
    impact: '100+ documents processed',
  },
];

const projects = [
  { number: '01', title: 'AI Agent Testing', label: 'Agent evaluation', description: 'Built tests to check whether AI agents use the right information, respond promptly, and reason consistently. Reduced model output drift by 35% at CCC.', tags: ['LLMs', 'observability', 'evaluation'], accent: 'orange', glyph: 'pulse' },
  { number: '02', title: 'EEG-Based Adaptive Audio', label: 'NeurotechX UIUC', description: 'Developed 3 supervised learning models to classify cognitive states from EEG data, then connected the results to Spotify for adaptive audio playback.', tags: ['BCI', 'Python', 'Spotipy'], accent: 'blue', glyph: 'wave' },
  { number: '03', title: 'Arduino Projects', label: 'Arduino projects', description: 'Built 6 embedded systems projects in C/C++, including an ultrasonic measuring tool and autonomous navigation prototypes.', tags: ['C/C++', 'sensors', 'autonomy'], accent: 'lime', glyph: 'orbit' },
  { number: '04', title: 'Formula SAE Circuit Design', label: 'Illini Electric Motorsports', description: 'Designed 5 high- and low-voltage circuits for a Formula SAE electric vehicle. Tested them with SPICE simulations and worked with other teams on integration.', tags: ['Altium', 'SPICE', 'EV systems'], accent: 'violet', glyph: 'grid' },
];

const skills = ['Python', 'C++', 'Go', 'TypeScript', 'Assembly', 'LangGraph', 'PostgreSQL', 'React', 'Arduino', 'Altium Designer', 'MCP', 'NATS'];
---

<Layout title="Kian Karbassian - Computer Engineering Student">
  <main id="main-content">
    <section class="hero" id="top">
      <div class="container hero-inner">
        <div class="hero-kicker reveal">Computer engineering at UIUC</div>
        <div class="hero-layout">
          <div class="hero-copy">
            <p class="hero-index reveal">AI &amp; Software Engineering</p>
            <h1 class="hero-title reveal">Kian<br /><span>Karbassian</span></h1>
            <p class="hero-description reveal">I’m a computer engineering student at the University of Illinois Urbana-Champaign, with experience in AI, software engineering, and embedded systems.</p>
            <div class="hero-actions reveal"><a class="button button-primary" href="#work">View projects <span>↘</span></a><a class="text-link" href="/resume.pdf" target="_blank" rel="noopener">Open résumé <span>↗</span></a></div>
          </div>
          <Signal />
        </div>

      </div>
    </section>

    <section class="intro section-light" id="about"><div class="container intro-grid"><div class="section-marker reveal"><span>About</span></div><div class="intro-copy"><h2 class="display reveal">About me</h2><p class="body-copy reveal">My interests include multimodal AI, agent evaluation, neurotechnology, and embedded hardware. Through internships and student teams, I’ve built AI tools, backend software, and circuits. I expect to graduate in May 2028.</p><div class="fact-row reveal"><div><strong>May 2028</strong><span>Expected graduation</span></div><div><strong>UIUC</strong><span>Computer engineering</span></div><div><strong>AI + ECE</strong><span>Areas of interest</span></div></div></div></div></section>

    <section class="experience section-dark" id="experience"><div class="container"><div class="section-head reveal"><div class="section-marker section-marker-dark"><span>Experience</span></div><h2 class="display display-light">Experience</h2></div><div class="experience-list">{experience.map((item, index) => (<article class={`experience-item accent-${item.accent} reveal`}><div class="experience-number">{item.type}</div><div class="experience-main"><div class="experience-meta"><span>{item.time}</span></div><h3><a class="employer-link" href={item.url} target="_blank" rel="noopener noreferrer">{item.company}<span aria-hidden="true"> ↗</span></a></h3><p class="experience-role">{item.role} <span>·</span> {item.place}</p><ul class="experience-summary">{item.summary.map((point) => <li>{point}</li>)}</ul>{index === 0 && <DamageScan />}{item.company === 'Lossdog' && <MarketScan />}</div><div class="experience-impact"><span>Numbers</span><strong>{item.impact}</strong></div></article>))}</div></div></section>

    <section class="work section-cream" id="work"><div class="container"><div class="work-heading reveal"><div class="section-marker"><span>Selected work</span></div><div><h2 class="display">Projects</h2></div><p class="body-copy">Selected projects in AI, embedded systems, and electrical engineering.</p></div><div class="project-grid">{projects.map((project) => (<article class={`project-card project-${project.accent} reveal`}><div class="project-card-top"><span class="project-label">{project.label}</span></div><div class={`project-glyph glyph-${project.glyph}`} aria-hidden="true">{project.glyph === 'pulse' && <><span></span><span></span><span></span><span></span><span></span><span></span></>}{project.glyph === 'wave' && <div class="audio-wave">{Array.from({ length: 25 }, (_, i) => <span style={`--wave-height:${12 + Math.sin(i * .65) ** 2 * 44 + Math.sin(i * .27) ** 2 * 18}px;--wave-delay:${-i * .13}s`}></span>)}</div>}{project.glyph === 'orbit' && <><i></i><i></i><i></i></>}{project.glyph === 'grid' && <><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></>}</div><h3>{project.title}</h3><p>{project.description}</p><div class="project-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div></article>))}</div></div></section>

    <section class="toolkit section-dark" id="toolkit"><div class="container toolkit-grid"><div><div class="section-marker section-marker-dark reveal"><span>Toolkit</span></div><h2 class="display display-light reveal">Technical skills</h2><p class="body-copy body-copy-light reveal">Languages, frameworks, and tools I’ve used across my work and projects.</p></div><div class="skills-cloud reveal">{skills.map((skill, index) => <span class={`skill-chip chip-${index % 4}`}>{skill}</span>)}</div></div></section>

    <section class="contact section-orange" id="contact"><div class="container contact-inner"><div class="section-marker reveal"><span>Contact</span></div><div class="contact-copy"><h2 class="display reveal">Contact</h2><div class="contact-links reveal"><a class="contact-email" href="mailto:kiank2@illinois.edu">kiank2@illinois.edu <span>↗</span></a><a class="text-link text-link-dark" href="https://linkedin.com/in/kiankarbassian" target="_blank" rel="noopener">LinkedIn <span>↗</span></a></div></div></div></section>
  </main>
</Layout>
