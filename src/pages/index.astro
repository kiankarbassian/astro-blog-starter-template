---
import Layout from '../layouts/Layout.astro';
import Signal from '../components/Signal.astro';
import DamageScan from '../components/DamageScan.astro';
import MarketScan from '../components/MarketScan.astro';
import CPUWorkbench from '../components/CPUWorkbench.astro';

const experience = [
  {
    company: 'CCC Intelligent Solutions', url: 'https://www.cccis.com/', role: 'AI Engineering Intern', time: 'May 2026 - present', place: 'Chicago, IL', type: 'AI systems', accent: 'orange',
    summary: [
      'Developed a vehicle damage assessment pipeline combining multimodal AI, agent-controlled image cropping, and reference imagery aggregated from multiple APIs.',
      'Implemented specialized agents for vehicle-area analysis and a multistage debate workflow to compare and refine damage assessments.',
      'Built a reproducible evaluation framework across 126 standardized images, using ground-truth comparisons and agent-assisted error analysis to measure precision and recall and diagnose false positives and missed damage.',
    ],
    impact: '126 standardized images · Precision & recall',
  },
  {
    company: 'Lossdog', url: 'https://lossdog.com/', role: 'Software Engineering Intern', time: 'Jan 2026 - May 2026', place: 'Chicago, IL', type: 'Infrastructure', accent: 'lime',
    summary: [
      'Independently built an internal administration app using React Admin, Go, and PostgreSQL, integrating an AI agent capable of creating, reading, updating, and deleting database records to reduce manual administrative work.',
      'Implemented a cryptocurrency quote ingestion pipeline that consolidated multiple feeds and buffered bursts and irregular updates, processing 1,000+ quotes per second with under 50ms latency.',
      'Developed a prediction-market analysis tool combining Kalshi and Polymarket listings with AI assessments and trading metrics to flag potential insider-influence and manipulation risks and surface potential trading opportunities.',
    ],
    impact: '1,000+ quotes / sec · <50ms latency',
  },
  {
    company: 'Crédit Agricole (CACIB)', url: 'https://www.ca-cib.com/home', role: 'RPA Intern', time: 'Jul 2021 - Sept 2021', place: 'Hong Kong', type: 'Automation', accent: 'blue',
    summary: ['Automated OCR extraction and web scraping for documents and market data feeds.'],
    impact: '100+ documents processed',
  },
];

const projects = [
  { number: '01', title: '16-bit SLC-3 Processor on FPGA', label: 'Digital systems · ECE 385', description: 'Built a 16-bit SLC-3.2 datapath for a Spartan-7 FPGA in SystemVerilog, with an ALU, 8-register file, control FSM, BRAM interface and memory-mapped board I/O.', tags: ['SystemVerilog', 'Vivado', 'Spartan-7'], accent: 'orange', glyph: 'chip' },
  { number: '02', title: 'Agent Evaluation Framework', label: 'Agent evaluation', description: 'An evaluation framework that measures grounding, latency, and reasoning quality in AI agents.', tags: ['LLMs', 'observability', 'evaluation'], accent: 'orange', glyph: 'pulse' },
  { number: '03', title: 'EEG-Based Adaptive Audio', label: 'NeurotechX UIUC', description: 'Supervised models classify cognitive states from EEG streams and translate them into adaptive audio via the Spotify API.', tags: ['BCI', 'Python', 'Spotipy'], accent: 'blue', glyph: 'wave' },
  { number: '04', title: 'Arduino Projects', label: 'Arduino projects', description: 'Six embedded systems experiments in C/C++ - from ultrasonic sensing to autonomous navigation prototypes.', tags: ['C/C++', 'sensors', 'autonomy'], accent: 'lime', glyph: 'orbit' },
  { number: '05', title: 'Formula SAE Circuit Design', label: 'Illini Electric Motorsports', description: 'Designed five high- and low-voltage circuits for Formula SAE Electric, with SPICE simulation and cross-team integration.', tags: ['Altium', 'SPICE', 'EV systems'], accent: 'violet', glyph: 'grid' },
];

const skills = ['Python', 'C++', 'Go', 'TypeScript', 'Assembly', 'SystemVerilog', 'Xilinx Vivado', 'LangGraph', 'PostgreSQL', 'React', 'Arduino', 'Altium Designer', 'MCP', 'NATS'];
---

<Layout title="Kian Karbassian - AI + systems engineer">
  <main id="main-content">
    <section class="hero" id="top">
      <div class="container hero-inner">
        <div class="hero-kicker reveal">Computer engineering at UIUC</div>
        <div class="hero-layout">
          <div class="hero-copy">
            <p class="hero-index reveal">AI &amp; Software Engineering</p>
            <h1 class="hero-title reveal">Kian<br /><span>Karbassian</span></h1>
            <p class="hero-description reveal">I’m a computer engineering student at the University of Illinois Urbana-Champaign, with experience in AI, software engineering, and embedded systems.</p>
            <div class="hero-actions reveal"><a class="button button-primary" href="#work">View projects <span>↘</span></a><a class="text-link" href="/resume.pdf" target="_blank" rel="noopener">Open résumé <span>↗</span></a><a class="linkedin-icon" href="https://linkedin.com/in/kiankarbassian" target="_blank" rel="noopener noreferrer" aria-label="Kian Karbassian on LinkedIn" title="LinkedIn"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96C2 21.32 2.69 22 3.55 22h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8v-4.64c0-1.1-.02-2.52-1.54-2.52-1.54 0-1.78 1.2-1.78 2.44v4.72H9.53V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.8-1.52 3 0 3.55 1.98 3.55 4.56v5.21Z"/></svg></a></div>
          </div>
          <Signal />
        </div>

      </div>
    </section>

    <section class="intro section-light" id="about"><div class="container intro-grid"><div class="section-marker reveal"><span>About</span></div><div class="intro-copy"><h2 class="display reveal">About me</h2><p class="body-copy reveal">My interests include multimodal AI, agent evaluation, neurotechnology, and embedded hardware. I’ve worked on computer vision systems, backend infrastructure, and circuit design. I expect to graduate in May 2028.</p><div class="fact-row reveal"><div><strong>May 2028</strong><span>Expected graduation</span></div><div><strong>UIUC</strong><span>Computer engineering</span></div><div><strong>AI + ECE</strong><span>Areas of interest</span></div></div></div></div></section>

    <section class="experience section-dark" id="experience"><div class="container"><div class="section-head reveal"><div class="section-marker section-marker-dark"><span>Experience</span></div><h2 class="display display-light">Experience</h2></div><div class="experience-list">{experience.map((item, index) => (<article class={`experience-item accent-${item.accent} reveal`}><div class="experience-number">{item.type}</div><div class="experience-main"><div class="experience-meta"><span>{item.time}</span></div><h3><a class="employer-link" href={item.url} target="_blank" rel="noopener noreferrer">{item.company}<span aria-hidden="true"> ↗</span></a></h3><p class="experience-role">{item.role} <span>·</span> {item.place}</p><ul class="experience-summary">{item.summary.map((point) => <li>{point}</li>)}</ul>{index === 0 && <DamageScan />}{item.company === 'Lossdog' && <MarketScan />}</div><div class="experience-impact"><span>impact</span><strong>{item.impact}</strong></div></article>))}</div></div></section>

    <section class="work section-cream" id="work"><div class="container"><div class="work-heading reveal"><div class="section-marker"><span>Selected work</span></div><div><h2 class="display">Projects</h2></div><p class="body-copy">Selected projects in AI, embedded systems, and electrical engineering.</p></div><div class="project-grid">{projects.map((project, index) => (<article class={`project-card project-${project.accent} reveal`}><div class="project-card-top"><span class="project-label">{project.label}</span></div><div class={`project-glyph glyph-${project.glyph}`} aria-hidden="true">{project.glyph === 'chip' && <svg class="project-datapath-preview" viewBox="0 0 310 150" fill="none" xmlns="http://www.w3.org/2000/svg"><path class="dp-mini-wire" d="M61 51V76H268M137 51V76M210 51V76M268 76V102M63 102V76" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 5"/><g stroke="currentColor" stroke-width="1.2"><rect x="6" y="14" width="82" height="37" rx="3"/><rect x="103" y="14" width="72" height="37" rx="3"/><rect x="188" y="14" width="116" height="37" rx="3"/><rect x="7" y="102" width="108" height="37" rx="3"/><rect x="147" y="102" width="84" height="37" rx="3"/><rect x="244" y="102" width="60" height="37" rx="3"/></g><g fill="currentColor" font-size="10" font-family="monospace" text-anchor="middle"><text x="47" y="37">PC / IR</text><text x="139" y="37">ALU</text><text x="246" y="37">REG FILE</text><text x="61" y="124">MAR / MDR</text><text x="189" y="124">CONTROL</text><text x="274" y="124">BRAM</text><text x="155" y="69" font-size="8">16-bit bus</text></g></svg>}{project.glyph === 'pulse' && <><span></span><span></span><span></span><span></span><span></span><span></span></>}{project.glyph === 'wave' && <div class="audio-wave">{Array.from({ length: 25 }, (_, i) => <span style={`--wave-height:${12 + Math.sin(i * .65) ** 2 * 44 + Math.sin(i * .27) ** 2 * 18}px;--wave-delay:${-i * .13}s`}></span>)}</div>}{project.glyph === 'orbit' && <><i></i><i></i><i></i></>}{project.glyph === 'grid' && <><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></>}</div><h3>{project.title}</h3><p>{project.description}</p><div class="project-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>{index === 0 && <button class="cpu-project-link" type="button" data-open-cpu>Explore the interactive CPU <span aria-hidden="true">↗</span></button>}</article>))}</div>
      <details class="cpu-project-details" id="cpu-demo">
        <summary class="cpu-project-summary">
          <div class="cpu-project-summary-text">
            <span class="cpu-project-eyebrow">PROJECT 01 / INTERACTIVE DEMONSTRATION</span>
            <strong>Explore the SLC-3.2 datapath.</strong>
            <p>Trace instructions, control signals, registers, and the xFFFF I/O interface.</p>
          </div>
          <span class="cpu-project-cta">Open workbench <span aria-hidden="true">↗</span></span>
        </summary>
        <CPUWorkbench />
      </details>
    </div></section>

    <section class="toolkit section-dark" id="toolkit"><div class="container toolkit-grid"><div><div class="section-marker section-marker-dark reveal"><span>Toolkit</span></div><h2 class="display display-light reveal">Technical skills</h2><p class="body-copy body-copy-light reveal">Languages, frameworks, and tools I’ve used across my work and projects.</p></div><div class="skills-cloud reveal">{skills.map((skill, index) => <span class={`skill-chip chip-${index % 4}`}>{skill}</span>)}</div></div></section>

    <section class="contact section-orange" id="contact"><div class="container contact-inner"><div class="section-marker reveal"><span>Contact</span></div><div class="contact-copy"><h2 class="display reveal">Contact</h2><div class="contact-links reveal"><a class="contact-email" href="mailto:kiank2@illinois.edu">kiank2@illinois.edu <span>↗</span></a></div></div></div></section>
  </main>
</Layout>

<style>
  :global(.project-glyph.glyph-chip){top:55px;right:25px;width:290px;height:150px;transform:none;opacity:.92;border:0;border-radius:0}
  :global(.project-glyph.glyph-chip)::before,:global(.project-glyph.glyph-chip)::after{display:none}
  .project-datapath-preview{display:block;width:100%;height:100%;color:var(--accent)}
  .dp-mini-wire{animation:mini-trace 3s linear infinite}
  @keyframes mini-trace{to{stroke-dashoffset:-40}}
  @media(max-width:500px){:global(.project-glyph.glyph-chip){width:230px;height:120px;right:18px;top:60px}}
  @media(prefers-reduced-motion:reduce){.dp-mini-wire{animation:none}}
  .cpu-project-link{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-top:23px;padding:12px 0 5px;border:0;border-top:1px solid var(--line);background:transparent;color:var(--accent);font:12px var(--mono);text-align:left;width:100%}
  .cpu-project-link:hover,.cpu-project-link:focus-visible{color:var(--text)}
  .cpu-project-link span{font-size:18px;line-height:1}
  .cpu-project-details{margin-top:28px;border:1px solid var(--line);border-radius:6px;overflow:hidden}
  .cpu-project-summary{display:flex;align-items:center;justify-content:space-between;gap:35px;cursor:pointer;padding:30px 35px;background:var(--surface);list-style:none}
  .cpu-project-summary::-webkit-details-marker{display:none}
  .cpu-project-summary:hover{background:color-mix(in srgb,var(--surface) 90%,var(--accent))}
  .cpu-project-summary:focus-visible{outline:2px solid var(--accent);outline-offset:-3px}
  .cpu-project-eyebrow{display:block;font:10px var(--mono);letter-spacing:.075em;color:var(--accent);margin-bottom:7px}
  .cpu-project-summary strong{display:block;font:500 clamp(20px,2.3vw,30px)/1.25 var(--sans);letter-spacing:-.04em}
  .cpu-project-summary p{font-size:13px;color:var(--muted);margin:7px 0 0}
  .cpu-project-cta{display:flex;align-items:center;gap:25px;white-space:nowrap;border:1px solid var(--line);padding:13px 16px;border-radius:4px;font:12px var(--mono)}
  .cpu-project-details[open] .cpu-project-cta{border-color:var(--accent);color:var(--accent)}
  .cpu-project-details[open] .cpu-project-cta>span{transform:rotate(90deg)}
  @media(max-width:700px){.cpu-project-summary{padding:20px;align-items:flex-start;flex-direction:column;gap:20px}.cpu-project-cta{width:100%;justify-content:space-between}}
</style>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open-cpu]').forEach(button => {
    button.addEventListener('click', () => {
      const details = document.querySelector<HTMLDetailsElement>('#cpu-demo');
      if (!details) return;
      details.open = true;
      details.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });
    });
  });
</script>
